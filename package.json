  "author": "Prathik Murugan",
  "homepage": "https://github.com/prathikmurugan/jsonbit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/prathikmurugan/jsonbit.git"
  },
  "bugs": {
    "url": "https://github.com/prathikmurugan/jsonbit/issues"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@toon-format/toon": "^4.4.0",
    "@types/node": "^25.8.0",
    "gpt-tokenizer": "^4.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
