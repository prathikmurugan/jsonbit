{
  "name": "@jsonbit/core",
  "version": "1.1.6",
  "description": "jsonbit — Pure-Rust Auto-3NF Columnar Bit-Packed & BitVec64 Engine for LLMs and AI Agents",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "jsonbit": "./bin/jsonbit.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./scripts/install-binary.mjs",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "bench": "NODE_NO_WARNINGS=1 tsx benchmarks/run-full-rust-benchmark.ts --reuse-gemini",
    "cli": "node ./bin/jsonbit.js"
  },
  "keywords": [
    "llm",
    "olap",
    "json",
    "jsonbit",
    "rust",
    "3nf",
    "agents",
    "mcp",
    "tokens"
  ],
